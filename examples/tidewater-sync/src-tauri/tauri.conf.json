{
  "productName": "Tidewater Sync",
  "version": "0.4.0",
  "identifier": "com.example.tidewatersync",
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "windows": {
      "signCommand": "sign-tool --file %1"
    },
    "macOS": {
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://releases.example.com/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
